{
  "name": "@pixela/voxel-cli",
  "version": "0.2.0",
  "description": "CLI tool for Voxel design system — component docs, tokens, and agent tooling",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "voxel": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm generate && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "generate": "tsx src/generate.ts"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.0",
    "vitest": "latest"
  },
  "keywords": [
    "voxel",
    "cli",
    "design-system",
    "ai",
    "agent"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "author": "pixela-gt",
  "license": "MIT"
}
