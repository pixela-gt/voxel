{
  "name": "@pixela-gt/voxel-cli",
  "version": "0.1.0",
  "description": "CLI tool for Voxel design system — component docs, tokens, and agent tooling",
  "type": "module",
  "main": "./dist/index.mjs",
  "bin": {
    "voxel": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "generate": "node --loader ts-node/esm src/generate.ts"
  },
  "dependencies": {
    "@pixela-gt/voxel-cli": "link:",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@pixela-gt/voxel-ui": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@pixela-gt/voxel-ui": {
      "optional": true
    }
  },
  "keywords": [
    "voxel",
    "cli",
    "design-system",
    "ai",
    "agent"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "author": "pixela-gt",
  "license": "MIT"
}
