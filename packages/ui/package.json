{
  "name": "@pixela-gt/voxel-ui",
  "version": "0.1.0",
  "description": "Vue component design system based on reka-ui with Tailwind CSS",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./layouts": {
      "types": "./dist/layouts/index.d.ts",
      "import": "./dist/layouts/index.mjs"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "import": "./dist/patterns/index.mjs"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables/index.mjs"
    },
    "./style.css": "./dist/assets/voxel-ui.css",
    "./tokens.css": "./dist/tokens/tokens.css",
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && mkdir -p dist/tokens && cp src/tokens/tokens.css dist/tokens/tokens.css && tsc --emitDeclarationOnly --declaration --declarationDir dist --noEmit false",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@lucide/vue": "^1.0.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@pixela-gt/voxel-ui": "link:",
    "reka-ui": "^2.9.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@internationalized/date": "^3.12.2",
    "@lucide/vue": "1.25.0",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/vue3-vite": "^10.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint-plugin-storybook": "10.5.7",
    "postcss": "^8.5.22",
    "prettier": "^3.9.6",
    "reka-ui": "^2.9.0",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vue": "^3.4.0",
    "vue-tsc": "^3.3.8"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "vue",
    "components",
    "design-system",
    "reka-ui",
    "tailwindcss",
    "accessible"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "author": "pixela-gt",
  "license": "MIT"
}
