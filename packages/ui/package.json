{
  "name": "@pixela-gt/voxel-ui",
  "version": "0.1.0",
  "description": "Vue component design system based on reka-ui with Tailwind CSS",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./tokens.css": "./dist/tokens/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly --declaration --declarationDir dist --noEmit false",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "reka-ui": "^2.9.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@lucide/vue": "^1.26.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "postcss": "^8.5.22",
    "reka-ui": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vue": "^3.4.0",
    "vue-tsc": "^3.3.8"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "vue",
    "components",
    "design-system",
    "reka-ui",
    "tailwindcss",
    "accessible"
  ],
  "author": "pixela-gt",
  "license": "MIT"
}
