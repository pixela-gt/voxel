{
  "name": "@pixela-gt/voxel-ui",
  "version": "0.1.0",
  "description": "Vue component design system based on reka-ui with Tailwind CSS",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./tokens.css": "./dist/tokens/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly --declaration --declarationDir dist --noEmit false",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "reka-ui": "^2.9.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.22.0",
    "@lucide/vue": "^0.1.0",
    "postcss": "^8.4.35",
    "reka-ui": "^2.9.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vite-plugin-dts": "^5.0.3",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "vue",
    "components",
    "design-system",
    "reka-ui",
    "tailwindcss",
    "accessible"
  ],
  "author": "pixela-gt",
  "license": "MIT"
}
